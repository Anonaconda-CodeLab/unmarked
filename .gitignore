# Never commit files you cleaned (or their originals): only the test fixtures are tracked
# (patterns ignore case: phones save IMG_0001.JPG)
*.[jJ][pP][gG]
*.[jJ][pP][eE][gG]
*.[pP][nN][gG]
*.[wW][eE][bB][pP]
*.[hH][eE][iI][cC]
*.[hH][eE][iI][fF]
*.[aA][vV][iI][fF]
*.[pP][dD][fF]
*.[zZ][iI][pP]
!tests/fixtures/*
!src/icons/*
!dist/*.png
!docs/screenshots/*.png
!mobile/android/app/src/main/res/**/*.png

# Tooling
node_modules/
dist/fragment.html
.DS_Store
Thumbs.db

# Android signing keys never go in the repository
*.jks
*.keystore
